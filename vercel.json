{
  "version": 2,
  "alias": ["smk-backend-api.vercel.app"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/meta-poll-5m",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/meta-report-sync",
      "schedule": "29 18 * * *"
    },
    {
      "path": "/api/cron/check-lead-source-health",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/google-sheets-sync",
      "schedule": "15 19 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
