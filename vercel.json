{
  "alias": ["lms.sociomonkey.com", "sociomonkey-ai.vercel.app"],
  "headers": [
    {
      "source": "/env.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    { "source": "/ganga/lms", "destination": "/ganga-realty", "permanent": true },
    { "source": "/ganga/lms/login", "destination": "/ganga-realty/login", "permanent": true },
    { "source": "/:tenant/lms", "destination": "/:tenant", "permanent": true },
    { "source": "/:tenant/lms/login", "destination": "/:tenant/login", "permanent": true },
    { "source": "/apps/lms/:tenant/login", "destination": "/:tenant/login", "permanent": true },
    { "source": "/apps/lms/:tenant/:tab", "destination": "/:tenant/:tab", "permanent": true },
    { "source": "/apps/lms/:tenant", "destination": "/:tenant", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://smk-backend-api.vercel.app/api/$1" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/data-deletion", "destination": "/data-deletion.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
